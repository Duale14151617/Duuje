{
  "name": "armyhq-frontend",
  "private": true,
  "version": "2.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "e2e": "playwright test",
    "build:netlify": "npm run build && node scripts/netlify-dist.mjs",
    "build:demo": "tsc --noEmit && vite build --mode demo && node scripts/netlify-dist.mjs --demo"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.1",
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.47.0",
    "eslint": "^9.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.9.0",
    "typescript-eslint": "^8.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
