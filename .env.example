# Copy to backend/.env and export before running (or use your process manager). NEVER commit real values.
DJANGO_DEBUG=0
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
DJANGO_ALLOWED_HOSTS=armyhq.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://armyhq.example.org
# Set to 1 only behind a reverse proxy that sets X-Forwarded-Proto / X-Forwarded-For and strips client values.
TRUST_PROXY_HEADERS=0
POSTGRES_DB=armyhq
POSTGRES_USER=armyhq_app
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
SESSION_IDLE_SECONDS=1800
THROTTLE_LOGIN=10/min
ENABLE_API_DOCS=0
# 1.4 hardening knobs (defaults shown)
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
MAX_REQUEST_BYTES=2000000
THROTTLE_BULK=30/hour
NUM_PROXIES=1            # only used when TRUST_PROXY_HEADERS=1
# Backups (ops/backup.sh): BACKUP_DIR=/var/backups/armyhq  AGE_RECIPIENT=age1...  (private key stays offline)
# Personnel CSV export stays OFF until the institution approves it.
PERSONNEL_EXPORT_ENABLED=0
# Summary CSV export stays OFF until approved too.
REPORT_EXPORT_ENABLED=0
# 2.0: inbound read-only integration API. OFF until the institution approves each integration (docs/INTEGRATIONS.md).
INTEGRATIONS_ENABLED=0
INTEGRATION_MAX_DAYS=365        # longest allowed key lifetime
INTEGRATION_MIN_CELL=5          # aggregate cells below this are withheld from integration responses
THROTTLE_INTEGRATION=60/min     # per integration client
INTEGRATION_ALLOW_UNIT_FILTER=0 # 1 lets keys use ?unit= (makes small-group reconstruction easier)
INTEGRATION_FAIL_LIMIT=20       # bad-key attempts per source address ...
INTEGRATION_FAIL_WINDOW=600     # ... per this many seconds, then that address is refused
# 2.0: level changes (unit types) must be proposed and approved by a different person. 0 restores direct editing.
STRUCTURE_CHANGES_REQUIRE_APPROVAL=1
# Development only:
# DJANGO_DEBUG=1
# USE_SQLITE=1            # quick local runs / tests without PostgreSQL
# ARMYHQ_DEMO_PASSWORD=   # for `seed_demo_data` (12+ chars)
