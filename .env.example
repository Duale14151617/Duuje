DB_PASSWORD=change-me
Jwt__Key=generate-a-random-string-of-at-least-32-bytes
Jwt__Issuer=duale-buildlink
Jwt__Audience=duale-buildlink
Database__AutoMigrate=true
Bootstrap__AdminEmail=admin@example.com
Bootstrap__AdminPassword=use-a-long-unique-password
# base64 of 32 random bytes (openssl rand -base64 32). Encrypts TOTP secrets; losing it disables everyone's MFA.
Mfa__Key=generate-with-openssl-rand-base64-32
Files__Root=/data/files

# --- Phase 4: finance (all values are business decisions; the defaults below are placeholders, not policy) ---
Finance__AllowedCurrencies=USD
Finance__Methods=cash,bank,mobile_money,other
# Amounts at or below this may be approved/confirmed by the person who proposed them. 0 = separation of duties always.
Finance__SelfApprovalLimit=0
# HMAC-SHA256 secret shared with the payment provider for /payments/provider-callback (>= 16 chars). Unset = callbacks answer 503.
Finance__CallbackSecret=generate-a-random-string-of-at-least-16-chars
# --- Phase 5: notifications and background worker ---
Worker__Enabled=true
Worker__IntervalSeconds=30
Notifications__MaxAttempts=6
Notifications__BackoffSeconds=30
Reminders__JobLeadHours=2
Reminders__SkillExpiryDays=14
Reminders__ReviewHours=24
Reminders__PayableDays=3

# --- Phase 6: hardening ---
# Behind the TLS proxy: trust X-Forwarded-For/Proto (never enable if the API port is reachable directly).
Security__TrustProxy=false
# Comma-separated permissions that require the user to have MFA on (which roles must use MFA is a business decision), e.g.
# Security__MfaRequiredPermissions=company.verify,technician.verify,finance.refund.approve,finance.adjust,platform.finance
Security__MfaRequiredPermissions=
RateLimit__ApiPerMinute=600
# Production refuses to start without a scanner. Scanner__AllowNoop=true accepts that risk explicitly (not for real documents).
Scanner__ClamAv__Host=
Scanner__AllowNoop=false
# Prometheus scrape token (>= 16 chars). Unset = /metrics does not exist.
Metrics__Token=
Retention__IdempotencyDays=14

# --- Email via SMTP (Gmail: enable 2-Step Verification, then create an App Password at myaccount.google.com/apppasswords) ---
# Leave Smtp__Host empty to keep email off.
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__User=yourname@gmail.com
Smtp__Password=your-16-char-app-password
Smtp__From=yourname@gmail.com
Smtp__FromName=Duale
