# Copy to backend/.env and export before running (or use your process manager). NEVER commit real values.
DJANGO_DEBUG=0
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
DJANGO_ALLOWED_HOSTS=armyhq.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://armyhq.example.org
# Set to 1 only behind a reverse proxy that sets X-Forwarded-Proto / X-Forwarded-For and strips client values.
TRUST_PROXY_HEADERS=0
POSTGRES_DB=armyhq
POSTGRES_USER=armyhq_app
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require   # production default; 'prefer' is only the development default and can silently fall back to plaintext
SESSION_IDLE_SECONDS=1800
THROTTLE_LOGIN=10/min
ENABLE_API_DOCS=0
# 1.4 hardening knobs (defaults shown)
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
MAX_REQUEST_BYTES=2000000
THROTTLE_BULK=30/hour
NUM_PROXIES=1            # only used when TRUST_PROXY_HEADERS=1
# Backups (ops/backup.sh): BACKUP_DIR=/var/backups/armyhq  AGE_RECIPIENT=age1...  (private key stays offline)
# Personnel CSV export stays OFF until the institution approves it.
PERSONNEL_EXPORT_ENABLED=0
# Summary CSV export stays OFF until approved too.
REPORT_EXPORT_ENABLED=0
# 2.0: inbound read-only integration API. OFF until the institution approves each integration (docs/INTEGRATIONS.md).
INTEGRATIONS_ENABLED=0
INTEGRATION_MAX_DAYS=365        # longest allowed key lifetime
INTEGRATION_MIN_CELL=5          # aggregate cells below this are withheld from integration responses
THROTTLE_INTEGRATION=60/min     # per integration client
INTEGRATION_ALLOW_UNIT_FILTER=0 # 1 lets keys use ?unit= (makes small-group reconstruction easier)
INTEGRATION_FAIL_LIMIT=20       # bad-key attempts per source address ...
INTEGRATION_FAIL_WINDOW=600     # ... per this many seconds, then that address is refused
# 2.0: level changes (unit types) must be proposed and approved by a different person. 0 restores direct editing.
STRUCTURE_CHANGES_REQUIRE_APPROVAL=1
# Development only:
# DJANGO_DEBUG=1
# USE_SQLITE=1            # quick local runs / tests without PostgreSQL
# POLICEHQ_SAMPLE_PASSWORD=   # for `seed_sample_data` (12+ chars)

# Synthetic sample people (Render: set in the dashboard). 0/unset removes them.
POLICEHQ_TEST_PERSONNEL=0

# Self-service email (all OFF by default; they need working outgoing email).
EMAIL_VERIFICATION_ENABLED=0     # users confirm their address with a 6-digit code (Account page)
BACKUP_HEARTBEAT_TOKEN=        # 24+ random characters; the nightly backup job reports in with it (System health page)
SESSION_IDLE_SECONDS=1800        # signed out after this long with no activity (the screen warns SESSION_IDLE_WARNING_SECONDS before)
SESSION_IDLE_WARNING_SECONDS=120
# Passkeys: leave empty to use the address the browser is on. Set only if the app is reachable under several hostnames.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=               # comma-separated full origins, e.g. https://policehq.example.so
SUPPORT_CONTACT=support@example.org   # shown in the footer to signed-in users (email or phone)
NOTIFICATION_EMAILS_ENABLED=0   # email users who opt in (Account page) when they have new notifications; generic text only, max one per 30 min
PASSWORD_FORGOT_ENABLED=0        # "Forgot your password?" on sign-in; only accounts with a VERIFIED address can use it
EMAIL_VERIFY_CODE_MINUTES=15
PASSWORD_FORGOT_CODE_MINUTES=30
# Gmail through a Google Apps Script web app (see docs/APPS_SCRIPT_MAILER.md). Wins over everything below when BOTH are set.
APPS_SCRIPT_URL=        # the Web app URL ending in /exec
APPS_SCRIPT_TOKEN=      # same value as the script's SECRET property
# Otherwise: BREVO_API_KEY (HTTPS, for hosts that block SMTP) wins over EMAIL_HOST (SMTP). With neither, codes are only printed to the log.
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@policehq.invalid   # Apps Script always sends from the Gmail account itself; for Brevo/SMTP it must be an allowed sender
# EMAIL_HOST=  EMAIL_PORT=587  EMAIL_HOST_USER=  EMAIL_HOST_PASSWORD=  EMAIL_USE_TLS=1

# Break-glass override of the different-person payroll rules (super admin only, written reason, audited). OFF unless set to 1 (it is on by default only in development).
POLICEHQ_BREAK_GLASS=1

# Step-up MFA: credential resets, role assignment, personnel export and break-glass need an authenticator code entered within this many
# seconds. On by default outside development (POLICEHQ_STEP_UP_MFA=0 turns it off).
POLICEHQ_STEP_UP_MFA=1
POLICEHQ_STEP_UP_SECONDS=600

# Security alert emails (comma-separated), in addition to every verified super administrator email.
POLICEHQ_ALERT_EMAILS=owner@example.org

# Encryption-key rotation (docs/KEY_ROTATION.md). FIELD_ENCRYPTION_KEY may list several keys, newest first: "NEW,OLD".
# Before the first rotation pin FIELD_HMAC_KEY to your CURRENT key so weapon-ID matching never changes.
# FIELD_HMAC_KEY=
# Send reset/recovery/notice emails from a background worker (default on outside development).
# POLICEHQ_EMAIL_ASYNC=1

# ID cards, letters and scheduled reports (docs/ID_CARDS_LETTERS_AND_SCHEDULES.md)
# ID_CARD_VALID_YEARS=2
# ISSUANCE_REF_PREFIX=PHQ
# SCHEDULED_REPORTS_ENABLED=1
# SCHEDULES_TIMEZONE=Africa/Mogadishu
# SCHEDULES_CRON_TOKEN=            # 24+ random characters; lets an outside pinger call POST /api/v1/schedules/run-due/

# Self-hosted Puntland map. Default file: backend/mapdata/puntland.pmtiles (joined from the three parts at build time; docs/VEHICLE_MAP.md).
# MAP_TILES_FILE=/path/to/puntland.pmtiles

# Position archive and purge (docs/POSITION_ARCHIVE.md). Only the archive/purge commands use these; keep the private key off the database host.
# ARCHIVE_SIGNING_KEY=          # from: python manage.py archive_keygen (private half)
# ARCHIVE_PUBLIC_KEYS=          # optional, comma separated public keys allowed to verify archives
# POSITION_RETENTION_DAYS=365   # default age for archive_positions (minimum 30)
# POSITION_PURGE_COOL_OFF_HOURS=24

# Daily movement report: the day runs midnight to midnight in this zone (IANA name).
# REPORT_TIME_ZONE=Africa/Mogadishu

# One-off MFA recovery on hosts without a shell: set to a username, deploy, then REMOVE it. Every start resets that user's MFA while it is set.
# RESET_MFA_USERNAME=
