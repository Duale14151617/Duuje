# One image for Render: React dashboard + ASP.NET Core API. The API serves the built dashboard from wwwroot (same origin, no CORS).
FROM node:20-alpine AS web
WORKDIR /web
COPY web/package.json ./
RUN npm install --no-audit --no-fund
COPY web/ ./
# vite bundles without type-checking; CI runs `tsc --noEmit` separately.
RUN npx vite build

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /repo
RUN dotnet tool install dotnet-ef --version 8.0.11 --tool-path /tools
COPY src/Duale.Api/ src/Duale.Api/
COPY scripts/render-migrations.sh scripts/
RUN bash scripts/render-migrations.sh
RUN dotnet publish src/Duale.Api -c Release -o /out /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /out .
COPY --from=web /web/dist ./wwwroot
COPY scripts/render-entrypoint.sh /entrypoint.sh
RUN useradd --system --uid 10001 --no-create-home duale && mkdir -p /data/files && chown -R duale /data/files && chmod +x /entrypoint.sh
ENV ASPNETCORE_URLS=http://+:8080 DOTNET_EnableDiagnostics=0 Web__ServeSpa=true
EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]
